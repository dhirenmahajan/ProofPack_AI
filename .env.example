# ============================================================================
# ProofPack AI — environment configuration
# Copy to .env and fill in. EVERYTHING runs without keys (stub providers),
# and automatically upgrades to real hosted inference once keys are present.
# Free-tier first: Google Gemini is the primary hosted provider.
# ============================================================================

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (pgvector) ---
# Inside docker-compose the host is "postgres". For local dev use "localhost".
POSTGRES_USER=proofpack
POSTGRES_PASSWORD=proofpack
POSTGRES_DB=proofpack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional: full DSN override (e.g. Supabase). Takes precedence over POSTGRES_* above.
# Must be a SQLAlchemy psycopg URL, e.g. postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL_OVERRIDE=

# --- Redis (Celery broker + external-API cache) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage ---
# local filesystem by default; set STORAGE_BACKEND=s3 for Cloudflare R2 / MinIO / S3.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
# Cloudflare R2 (recommended for production — free egress, S3-compatible API):
#   1. Create bucket:  ./scripts/cloudflare_r2_setup.sh
#   2. R2 API token:   Cloudflare dashboard → R2 → Manage API Tokens
#   3. Endpoint:       https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   4. Apply to Railway: ./scripts/railway_apply_r2.sh
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=proofpack
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Ingestion mode ---
# sync = run ingestion inside the upload request (simple/local)
# async = enqueue a Celery task; the worker ingests (scalable/prod)
INGEST_MODE=sync

# ============================================================================
# AI providers. Priority when *_PROVIDER=auto: Gemini key -> OpenAI key -> stub.
# ============================================================================

# --- Google Gemini (free tier — get a key at https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- LLM provider ---
LLM_PROVIDER=auto            # auto | gemini | openai | stub
LLM_MODEL=gpt-4o-mini        # used only when the OpenAI provider is active

# --- OpenAI (optional) ---
OPENAI_API_KEY=

# --- Embeddings provider ---
EMBEDDINGS_PROVIDER=auto     # auto | gemini | openai | stub
EMBEDDING_MODEL=text-embedding-3-small
# gemini-embedding-001 is requested at output dim 768. Changing this invalidates stored vectors.
EMBEDDING_DIM=768

# --- OCR / Vision provider ---
OCR_PROVIDER=auto            # auto | gemini | hf | tesseract | stub
HF_API_TOKEN=                # optional: https://huggingface.co/settings/tokens
HF_OCR_MODEL=microsoft/trocr-base-printed
TESSERACT_CMD=               # optional explicit path to the tesseract binary

# --- External public APIs (no auth required) ---
FEMA_API_BASE=https://www.fema.gov/api/open
NWS_API_BASE=https://api.weather.gov
NOMINATIM_API_BASE=https://nominatim.openstreetmap.org
# NWS + Nominatim require a descriptive User-Agent with contact info.
EXTERNAL_USER_AGENT=ProofPackAI/1.0 (contact: ops@proofpack.example)
EXTERNAL_CACHE_TTL_SECONDS=86400

# --- Observability (optional; Langfuse free tier at https://cloud.langfuse.com) ---
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production (Vercel): https://proofpack-api-production.up.railway.app
# Live frontend: https://frontend-cyan-iota-66.vercel.app
