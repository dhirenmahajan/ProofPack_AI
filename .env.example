# ============================================================================
# ProofPack AI — environment configuration
# Copy to .env and fill in. EVERYTHING runs without keys (stub providers),
# and automatically upgrades to real hosted inference once keys are present.
# ============================================================================

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (pgvector) ---
# Inside docker-compose the host is "postgres". For local dev use "localhost".
POSTGRES_USER=proofpack
POSTGRES_PASSWORD=proofpack
POSTGRES_DB=proofpack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (queues / future Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (local filesystem by default; S3-compatible later) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage

# --- LLM provider (hosted) ---
# Leave OPENAI_API_KEY blank to use the deterministic stub LLM.
LLM_PROVIDER=auto            # auto | openai | stub
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Embeddings provider (hosted) ---
EMBEDDINGS_PROVIDER=auto     # auto | openai | stub
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- OCR / Vision provider (hosted HF inference) ---
# Leave HF_API_TOKEN blank to use the stub (PDF text extraction still works).
OCR_PROVIDER=auto            # auto | hf | stub
HF_API_TOKEN=
HF_OCR_MODEL=microsoft/trocr-base-printed

# --- External public APIs (no auth required) ---
FEMA_API_BASE=https://www.fema.gov/api/open
NWS_API_BASE=https://api.weather.gov
NOMINATIM_API_BASE=https://nominatim.openstreetmap.org

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
