# Copy to .cloudflare-r2.env (gitignored) after creating an R2 API token.
# Cloudflare dashboard → Storage & databases → R2 → Manage API Tokens
# Permission: Object Read & Write, scoped to bucket "proofpack"

CLOUDFLARE_ACCOUNT_ID=
S3_BUCKET=proofpack
S3_REGION=auto
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
